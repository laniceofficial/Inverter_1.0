device STM32G474RB
si SWD
speed 8000
connect
halt
// setpiont
mem32 0x2000003c 1
// HalfBridgeController: currentFeed_, voltageCapFeed_, voltageBatFeed_
mem32 0x20000364 3
// duty_
mem32 0x2000037c 1
// state_ (10 bytes at offset 12 → 3 words)
mem32 0x20000370 3
// powerOn_ at offset 40
mem32 0x2000038c 1
// pidBuckI_ at offset 280 = 0x118: dump 17 words (68 bytes, full PID struct)
mem32 0x2000047c 17
exit
