/*********************************************************************
 * debug_exti_pa3.jlink
 *
 * 用途：调试 PA3 (rfidButtonPin) 上电后 EXTI3 持续触发的问题
 *
 * 使用方法：
 *   1. 确保 JLink 已连接目标板
 *   2. 在 JLinkExe 中执行: r
 *   3. 在 JLinkExe 中执行: loadfile Inverter_1.0.hex
 *   4. 在 JLinkExe 中执行: r
 *   5. 在 JLinkExe 中执行: g
 *   6. 运行本脚本: r
 *                       sleep 2000
 *                       debug_exti_pa3.jlink           (确保脚本在运行后执行)
 *
 *   或者在命令行一次性执行：
 *     JLinkExe -device STM32G474RE -if SWD -speed 4000 -autoconnect 1 -CommanderScript debug_exti_pa3.jlink
 *
 * 注意：需要根据实际芯片型号修改 -device 参数
 *********************************************************************/

// ============================================================
// 第一步：暂停 CPU，读取所有关键寄存器
// ============================================================

// 暂停 CPU
h

// ---- GPIOA 配置 -------------------------------------------------
// PA3 对应 GPIOA 的第 3 位
// GPIOA 基地址: 0x48000000
// MODER 偏移 0x00: 模式寄存器 (每2bit一个引脚, 00=输入, 01=输出, 10=AF, 11=模拟)
// PUPDR 偏移 0x0C: 上下拉寄存器 (每2bit一个引脚, 00=无, 01=上拉, 10=下拉, 11=保留)
// IDR   偏移 0x10: 输入数据寄存器 (每1bit一个引脚)
// OTYPER 偏移 0x04: 输出类型
// OSPEEDR 偏移 0x08: 速度

w4 0xE000EDF0 0xA05F0003  // 调试暂停时允许访问外设

// 读取并打印 GPIOA 关键寄存器
mem32 0x48000000 4         // GPIOA->MODER @ 0x00 (PA3 = bit[7:6])
mem32 0x48000004 1         // GPIOA->OTYPER @ 0x04 (PA3 = bit 3)
mem32 0x48000008 2         // GPIOA->OSPEEDR @ 0x08 (PA3 = bit[7:6])
mem32 0x4800000C 1         // GPIOA->PUPDR  @ 0x0C (PA3 = bit[7:6])
mem32 0x48000010 1         // GPIOA->IDR   @ 0x10 (PA3 = bit 3)

// ---- EXTI 配置 -------------------------------------------------
// EXTI 基地址: 0x40010400
// IMR1  偏移 0x00: 中断屏蔽寄存器 (bit 3 = EXTI3)
// EMR1  偏移 0x04: 事件屏蔽寄存器 (bit 3 = EXTI3)
// RTSR1 偏移 0x08: 上升沿触发选择寄存器 (bit 3 = EXTI3)
// FTSR1 偏移 0x0C: 下降沿触发选择寄存器 (bit 3 = EXTI3)
// PR1   偏移 0x14: 挂起寄存器 (bit 3 = EXTI3 pending, 写1清除)

mem32 0x40010400 4         // EXTI->IMR1, EXTI->EMR1, EXTI->RTSR1, EXTI->FTSR1
mem32 0x40010414 1         // EXTI->PR1 (挂起标志)

// ---- SYSCFG EXTICR -------------------------------------------------
// SYSCFG 基地址: 0x40010000
// EXTICR1 偏移 0x08: EXTI0-3 的端口选择 (EXTI3 = bit[15:12])
//   - 0000=PA, 0001=PB, 0010=PC, 0011=PD, ...

mem32 0x40010008 1         // SYSCFG->EXTICR1 (EXTI3 的端口选择, bit[15:12])

// ---- NVIC -------------------------------------------------
// NVIC ISER0: 0xE000E100 (EXTI3_IRQn = 9, bit 9)
// NVIC ICPR0: 0xE000E280 (清除挂起)
// NVIC IPR2:  0xE000E408 (EXTI3_IRQn 优先级)

mem32 0xE000E100 1         // NVIC->ISER[0] (bit 9 = EXTI3 enabled?)
mem32 0xE000E200 1         // NVIC->ISPR[0] (bit 9 = EXTI3 pending in NVIC?)
mem32 0xE000E408 1         // NVIC->IPR[2] (EXTI3 priority)

// ---- PWR/时钟状态（检查 STOP 模式配置）---------------------------------
// PWR 基地址: 0x58000400
// CR1 偏移 0x00
mem32 0x58000400 1         // PWR->CR1 (LPDS/LPREG 等)
// RCC 基地址: 0x58024400
// CSR 偏移 0x94: 包含 LSIRDY 等
mem32 0x58024494 1         // RCC->CSR

// ---- 打印当前 PC 指针（代码执行到哪里了）---------------------------------
// 读取并打印 R15 (PC)
r

// ============================================================
// 第二步：连续监控 PA3 电平和 EXTI 挂起标志
// ============================================================

// 如果第一步显示 PR1 bit 3 = 1（有挂起中断），执行这个连续监控：

WriteMem 0x20000000 4 0    // 清零计数器用
sleep 100

// 循环监控 100 次，每次间隔 200ms
// 用 while 循环检查 GPIOA_IDR bit 3 和 EXTI_PR1 bit 3
// 每次循环打印时间戳和状态

// ============================================================
// 第三步：单步追踪 WFI → EXTI 唤醒流程（可选，更高级）
// ============================================================

// 如果怀疑是 tryEnterLowPower 中的 WFI 被立即唤醒：
// 1. 先找到 tryEnterLowPower 的地址：
//    从 .map 文件搜索 WirelessChargeApp::tryEnterLowPower
//    假设地址为 0x0800XXXX
//
// 2. 在 WFI 指令处设断点（WFI = 0xBF30）：
//    SetBP 0x0800XXXX
//    g
//    断点命中后，用 Step 单步观察 PR1 寄存器变化
//
// 3. 在 HAL_PWR_EnterSTOPMode 返回后设断点：
//    检查 EXTI_PR1 和 GPIOA_IDR

// ============================================================
// 第四步：读取中断向量表确认 ISR 地址
// ============================================================

// EXTI3_IRQn = 9, 中断向量位于 VTOR + 9*4 + 16*4 (前16个是系统异常)
// 默认 VTOR = 0x08000000
// EXTI3_ISR 地址 = *(0x08000000 + (16+9)*4) = *(0x08000064)

mem32 0x08000064 1         // EXTI3_IRQHandler 地址
mem32 0x08000000 1         // VTOR 当前值

print "============================================"
print "PA3 (rfidButtonPin) 调试信息汇总"
print "============================================"
print "GPIOA->MODER[3]  (bit[7:6]): 00=输入, 01=输出, 10=AF, 11=模拟"
print "GPIOA->PUPDR[3]  (bit[7:6]): 00=无上下拉, 01=上拉, 10=下拉, 11=保留"
print "GPIOA->IDR[3]    (bit 3)   : 0=低电平, 1=高电平  <-- PA3 当前实际电平"
print "EXTI->RTSR1[3]   (bit 3)   : 0=禁止上升沿触发, 1=使能"
print "EXTI->PR1[3]     (bit 3)   : 0=无挂起, 1=有中断挂起未处理"
print "SYSCFG_EXTICR1[3](bit[15:12]): 0=PA, 1=PB, 2=PC, 3=PD..."
print "NVIC_ISPR[0][9]  (bit 9)   : 0=无挂起, 1=有挂起"
print "============================================"
print "关键判断："
print "  如果 IDR[3]=1 且 PUPDR[3]=10（下拉）→ 外部有上拉或噪声"
print "  如果 IDR[3]=1 且 PUPDR[3]=00（无上下拉）→ 引脚浮空(原问题)"
print "  如果 PR1[3]=1 持续存在 → ISR 未清除挂起位"
print "  如果 PR1[3]=1 但 ISR 已执行 → EXTI 再次被触发"
print "============================================"

// 恢复运行
g